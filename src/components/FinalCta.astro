---
import { Picture } from 'astro:assets';
import EstimateButton from './EstimateButton.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { site } from '../site/config';

const { finalCta } = site;
---
<section class="final" aria-labelledby="final-title">
  <div class="container">
    <div class="final-card" data-reveal>
      <Picture
        src={finalCta.image.src}
        alt=""
        widths={[640, 1280]}
        sizes="(min-width: 1200px) 1200px, 100vw"
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        quality={55}
        loading="lazy"
        decoding="async"
        class="final-bg"
      />
      <div class="final-content">
        <div class="final-copy">
          <h2 id="final-title">{finalCta.title}</h2>
          <p>{finalCta.body}</p>
        </div>
        <div class="final-actions">
          <EstimateButton label={finalCta.primaryCta} />
          <WhatsAppButton label={finalCta.secondaryCta} variant="ghost-light" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .final {
    padding-block: clamp(56px, 8vw, 96px);
  }

  .final-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--night);
    color: var(--on-night);
  }

  .final-card :global(.final-bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
  }

  .final-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(120deg, rgb(20 18 15 / 0.95) 0%, rgb(20 18 15 / 0.75) 60%, rgb(20 18 15 / 0.55) 100%);
  }

  .final-content {
    display: grid;
    gap: 28px;
    padding: 40px 24px;
  }

  h2 {
    font-size: clamp(2rem, 6vw, 3rem);
  }

  p {
    margin-top: 12px;
    max-width: 44ch;
    color: var(--on-night-muted);
    font-size: 1.0625rem;
  }

  .final-actions {
    display: grid;
    gap: 12px;
  }

  @media (min-width: 520px) {
    .final-actions {
      display: flex;
      flex-wrap: wrap;
    }
  }

  @media (min-width: 960px) {
    .final-content {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 48px;
      padding: 64px;
    }
  }
</style>
