---
import Icon from './Icon.astro';
import { isDemo } from '../site/config';
---
{
  isDemo && (
    <div class="demo-ribbon" role="note">
      <Icon name="info" size={16} />
      <span>
        <strong>Demo preview.</strong> Forms and messaging connect at launch.
      </span>
    </div>
  )
}

<style>
  .demo-ribbon {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 7px 16px;
    background: var(--night);
    color: var(--on-night-muted);
    font-size: 0.75rem;
    line-height: 1.3;
    text-align: center;
  }

  .demo-ribbon strong {
    color: var(--on-night);
    font-weight: 700;
  }

  .demo-ribbon .icon {
    flex: none;
    color: var(--accent-soft);
  }
</style>
