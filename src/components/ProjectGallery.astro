---
import { Picture, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { site } from '../site/config';

const { projects } = site;
const hasConcept = projects.items.some((p) => !p.image.verified);

const items = await Promise.all(
  projects.items.map(async (project) => {
    const full = await getImage({ src: project.image.src, width: 1600, format: 'webp', quality: 78 });
    const location = project.image.verified ? project.location : undefined;
    return { ...project, location, fullSrc: full.src };
  }),
);
---
<section class="section gallery" id="work" aria-labelledby="work-title">
  <div class="container">
    <SectionHeading eyebrow={projects.eyebrow} title={projects.title} intro={projects.intro} id="work-title" />

    <ul class="gallery-grid" data-gallery>
      {items.map((item, i) => (
        <li class:list={['gallery-item', { 'is-featured': i === 0 }]} data-reveal style={`--reveal-delay:${i * 0.08}s`}>
          <button
            type="button"
            class="gallery-card"
            data-lightbox-index={i}
            data-full-src={item.fullSrc}
            data-alt={item.image.alt}
            data-title={item.title}
            data-meta={[item.category, item.location].filter(Boolean).join(' · ')}
            data-concept={item.image.verified ? undefined : ''}
            aria-label={`View larger: ${item.title}`}
          >
            <Picture
              src={item.image.src}
              alt={item.image.alt}
              widths={[480, 720, 960, 1280]}
              sizes={i === 0 ? '(min-width: 1040px) 600px, (min-width: 640px) 100vw, 84vw' : '(min-width: 1040px) 300px, (min-width: 640px) 50vw, 84vw'}
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              quality={68}
              loading="lazy"
              decoding="async"
              class="gallery-img"
            />
            {!item.image.verified && <span class="gallery-badge">Concept image</span>}
            <span class="gallery-caption">
              <span class="gallery-text">
                <span class="gallery-meta">{[item.category, item.location].filter(Boolean).join(' · ')}</span>
                <span class="gallery-title">{item.title}</span>
              </span>
              <span class="gallery-expand"><Icon name="expand" size={18} /></span>
            </span>
          </button>
        </li>
      ))}
    </ul>

    {
      hasConcept && (
        <p class="gallery-note">
          <Icon name="info" size={18} />
          <span>{projects.conceptNotice}</span>
        </p>
      )
    }
  </div>

  <dialog class="lightbox" data-lightbox aria-label="Project image viewer">
    <div class="lightbox-frame">
      <img class="lightbox-img" alt="" data-lightbox-img decoding="async" />
      <div class="lightbox-bar">
        <div>
          <p class="lightbox-meta" data-lightbox-meta></p>
          <p class="lightbox-title" data-lightbox-title></p>
        </div>
        <div class="lightbox-controls">
          <button type="button" class="lightbox-btn" data-lightbox-prev aria-label="Previous image">
            <Icon name="chevronLeft" size={20} />
          </button>
          <button type="button" class="lightbox-btn" data-lightbox-next aria-label="Next image">
            <Icon name="chevronRight" size={20} />
          </button>
        </div>
      </div>
      <span class="gallery-badge lightbox-badge" data-lightbox-badge hidden>Concept image</span>
    </div>
    <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close">
      <Icon name="close" size={22} />
    </button>
  </dialog>
</section>

<style>
  .gallery-grid {
    display: flex;
    gap: 12px;
    margin: 32px -16px 0;
    padding: 0 16px 8px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 16px;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .gallery-grid::-webkit-scrollbar {
    display: none;
  }

  .gallery-item {
    flex: 0 0 84%;
    scroll-snap-align: start;
  }

  .gallery-card {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface-3);
    cursor: zoom-in;
    isolation: isolate;
  }

  .gallery-card :global(picture),
  .gallery-card :global(img) {
    width: 100%;
    height: 100%;
  }

  .gallery-card :global(img) {
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .gallery-card:hover :global(img) {
    transform: scale(1.04);
  }

  .gallery-card::after {
    content: '';
    position: absolute;
    inset: 45% 0 0;
    background: linear-gradient(180deg, rgb(20 18 15 / 0) 0%, rgb(20 18 15 / 0.78) 100%);
    pointer-events: none;
  }

  .gallery-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgb(255 253 249 / 0.9);
    backdrop-filter: blur(6px);
    color: var(--ink-2);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .gallery-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    padding: 18px;
    color: var(--on-night);
    text-align: left;
  }

  .gallery-text {
    display: grid;
    gap: 2px;
  }

  .gallery-meta {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-soft);
  }

  .gallery-title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .gallery-expand {
    display: grid;
    place-items: center;
    flex: none;
    width: 38px;
    height: 38px;
    border: 1px solid rgb(245 239 230 / 0.35);
    border-radius: 50%;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .gallery-card:hover .gallery-expand {
    background: rgb(245 239 230 / 0.14);
    border-color: rgb(245 239 230 / 0.7);
  }

  .gallery-note {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin-top: 20px;
    max-width: 68ch;
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .gallery-note :global(.icon) {
    flex: none;
    margin-top: 1px;
    color: var(--accent-ink);
  }

  @media (min-width: 640px) {
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      margin: 40px 0 0;
      padding: 0;
      overflow: visible;
    }

    .gallery-card {
      aspect-ratio: 4 / 3;
    }

    .gallery-item.is-featured {
      grid-column: 1 / -1;
    }

    .gallery-item.is-featured .gallery-card {
      aspect-ratio: 16 / 9;
    }
  }

  @media (min-width: 1040px) {
    .gallery-grid {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 250px;
      grid-auto-flow: dense;
      margin-top: 48px;
    }

    .gallery-card,
    .gallery-item.is-featured .gallery-card {
      aspect-ratio: auto;
    }

    .gallery-item.is-featured {
      grid-column: span 2;
      grid-row: span 2;
    }

    .gallery-item:nth-child(2) {
      grid-column: span 2;
    }

    .gallery-item.is-featured .gallery-title {
      font-size: 1.75rem;
    }

    .gallery-caption {
      padding: 22px;
    }
  }

  /* Lightbox */

  .lightbox {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(12 11 9 / 0.94);
    color: var(--on-night);
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
    animation: fade-in 0.25s ease;
  }

  .lightbox-frame {
    position: relative;
    width: min(100% - 32px, 1280px);
  }

  .lightbox-img {
    width: 100%;
    max-height: calc(100svh - 180px);
    object-fit: contain;
    border-radius: var(--radius-sm);
    background: var(--night-2);
  }

  .lightbox-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 16px;
  }

  .lightbox-meta {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-soft);
  }

  .lightbox-title {
    font-family: var(--font-display);
    font-size: 1.375rem;
  }

  .lightbox-controls {
    display: flex;
    gap: 8px;
  }

  .lightbox-btn,
  .lightbox-close {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid rgb(245 239 230 / 0.25);
    border-radius: 50%;
    background: transparent;
    color: var(--on-night);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .lightbox-btn:hover,
  .lightbox-close:hover {
    background: rgb(245 239 230 / 0.12);
  }

  .lightbox-close {
    position: absolute;
    top: 16px;
    right: 16px;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
</style>
